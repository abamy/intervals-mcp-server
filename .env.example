# Intervals.icu API Configuration

# Base URL (Optional, defaults to https://intervals.icu/api/v1)
# INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# Required: Your Intervals.icu API Key
API_KEY=your_intervals_api_key_here

# Required: Your Intervals.icu Athlete ID
ATHLETE_ID=your_athlete_id_here

# The API_KEY and ATHLETE_ID will be used as defaults for all API calls
# when these parameters are not explicitly provided to the tool functions.

# HTTP Transport Authentication (OAuth 2.0 — for Claude.ai and other MCP clients)
#
# When MCP_TRANSPORT is http/sse/streamable-http, set all three vars below to
# protect the endpoint with OAuth 2.0 authorization code + PKCE.
#
# Steps:
#   1. Choose any string for MCP_CLIENT_ID (e.g. "intervals-mcp")
#   2. Generate a strong random secret for MCP_CLIENT_SECRET
#   3. Set MCP_SERVER_URL to the public HTTPS URL of this server
#   4. In Claude.ai → Connectors → add MCP server, enter:
#        URL            = <MCP_SERVER_URL>/mcp
#        OAuth Client ID     = <MCP_CLIENT_ID>
#        OAuth Client Secret = <MCP_CLIENT_SECRET>
#
# Leave unset for local stdio use (no auth needed).
# MCP_CLIENT_ID=intervals-mcp
# MCP_CLIENT_SECRET=your_strong_random_secret_here
# MCP_SERVER_URL=https://your-mcp-server.onrender.com
